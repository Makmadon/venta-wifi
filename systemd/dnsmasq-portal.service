[Unit]
Description=Dnsmasq DHCP and Wildcard DNS for Captive Portal
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/usr/sbin/sysctl -w net.ipv4.ip_forward=1
ExecStart=/usr/sbin/dnsmasq -k --conf-file=/home/stalinft/Documentos/venta-wifi/network/dnsmasq.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
